# WooCommerce REST API (required for products, categories, store identity, and orders)
WC_URL=https://your-wordpress-site.com
WC_CONSUMER_KEY=ck_xxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxx

# Public storefront origin for canonical URLs, sitemap, and Open Graph
NEXT_PUBLIC_SITE_URL=https://your-storefront-domain.com

# CTX Feed XML URL from wp-admin (Feed URL on the CTX Feed screen).
# /feed rewrites <link> and <g:canonical_link> from the WordPress host to
# https://lumeero.us (/product/… becomes /products/…). Image URLs stay on WordPress.
# If NEXT_PUBLIC_SITE_URL is another storefront host, that host is used instead.
CTX_FEED_URL=https://your-wordpress-site.com/wp-content/uploads/woo-feed/google/xml/your-feed.xml

# Admin dashboard at /admin. Password and session secret stay on the server.
# PAYMENT_CONFIG_KEY is 32 bytes, base64. It encrypts payment accounts at rest.
# BLOB_READ_WRITE_TOKEN is the Vercel Blob store where those accounts are saved.
# Enter Stripe, PayPal, Affirm, and Afterpay keys in /admin, not here.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
PAYMENT_CONFIG_KEY=
BLOB_READ_WRITE_TOKEN=

# Contact form SMTP. The recipient is the WooCommerce email "From" address
# (WooCommerce → Settings → Emails), not a fixed inbox.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
